<?xml version="1.0" encoding="utf-8"?>
<!-- Status panel: the app's white surface with the 1dp hairline it uses above sheets. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/face_panel_border" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/face_panel_bg" />
        </shape>
    </item>
</layer-list>
