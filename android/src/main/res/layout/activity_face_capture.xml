<?xml version="1.0" encoding="utf-8"?>
<!--
  Native face capture (KYC selfie). One layout, many states, toggled by
  visibility from FaceCaptureActivity.setStage(): the camera preview with the
  bracket guide on top, a captured-photo review that replaces it after the
  shutter, and a light status panel whose copy, checklist, shutter and buttons
  change per state. Matches the approved Claude Design mock (variant 2a).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/face_bg">

    <!-- ============================== CAMERA ============================== -->

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- The captured JPEG is un-mirrored (what the backend gets); flip it here
         so the review looks like the mirrored preview the DB just saw. -->
    <ImageView
        android:id="@+id/reviewImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:scaleX="-1"
        android:visibility="gone"
        android:contentDescription="@string/face_cd_preview"
        android:background="@color/face_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <live.citymall.facecapture.FaceGuideOverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============================== TOP BAR ============================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/face_title"
            android:textColor="@color/face_topbar_text"
            android:textSize="14sp"
            android:letterSpacing="0.01" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/face_cd_close"
            android:src="@drawable/ic_face_close"
            app:tint="@color/face_topbar_icon" />
    </LinearLayout>

    <!-- =========================== STATUS PANEL =========================== -->

    <!-- Fixed height on purpose: a wrap_content panel grows for the checklist and
         shrinks for the buttons, and the camera preview above it re-lays out on
         every state change — visible jitter, and the bracket frame moves under
         the face mid-detection. 216dp fits the tallest state (title, two-line
         subtitle, four checklist rows); the activity adds the nav-bar inset. -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="0dp"
        android:layout_height="216dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_face_panel"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/statusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/face_text_primary"
            android:textSize="17sp"
            android:text="@string/face_align_title" />

        <TextView
            android:id="@+id/statusSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxWidth="260dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/face_text_secondary"
            android:textSize="12.5sp"
            android:text="@string/face_align_sub" />

        <LinearLayout
            android:id="@+id/checklist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/check1Icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_face_check_ring" />

                <TextView
                    android:id="@+id/check1Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:text="@string/face_check_face" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/check2Icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_face_check_ring" />

                <TextView
                    android:id="@+id/check2Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:text="@string/face_check_centered" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/check3Icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_face_check_ring" />

                <TextView
                    android:id="@+id/check3Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:text="@string/face_check_light" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/check4Icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_face_check_ring" />

                <TextView
                    android:id="@+id/check4Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:text="@string/face_check_straight" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/shutterButton"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_face_shutter"
            android:contentDescription="@string/face_cd_shutter"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/uploadProgress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:indeterminateTint="@color/face_accent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/ghostButton"
                style="@style/FaceCaptureButton"
                android:background="@drawable/bg_face_btn_ghost"
                android:textColor="@color/face_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/secondaryButton"
                style="@style/FaceCaptureButton"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_face_btn_secondary"
                android:textColor="@color/face_text_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/primaryButton"
                style="@style/FaceCaptureButton"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_face_btn_primary"
                android:textColor="@color/face_on_accent"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
